# Database / Supabase
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ORDER_CONFIRMATION_SECRET=replace-with-at-least-32-random-characters
UPLOAD_CLAIM_SECRET=replace-with-a-different-32-character-random-secret

# Public origin. Change to the real HTTPS domain after the OWNER buys and connects it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact info shown in the header and on product pages.
NEXT_PUBLIC_ZALO_PHONE=
# Personal Zalo chat link: https://zalo.me/<phone in 84-prefixed format, no leading 0>
NEXT_PUBLIC_ZALO_URL=
NEXT_PUBLIC_HOTLINE=
# Only works once a Facebook Page exists (m.me links don't work for personal profiles):
# https://m.me/<fanpage-username>. Leave empty until a Fanpage is created.
NEXT_PUBLIC_MESSENGER_URL=

# Cart temporarily hidden — set to "true" to restore add-to-cart, the cart icon, and /cart
# and /checkout. While false, customers are directed to Zalo/hotline instead.
NEXT_PUBLIC_CART_ENABLED=false
# English storefront (ADR-0048). While not "true": only VI is routable, /en/* 308-redirects to the
# VI page, sitemap/hreflang list VI only, and the Header + Organizer VI/EN toggles are hidden.
# Build-time (NEXT_PUBLIC_*): change it, then rebuild/redeploy.
NEXT_PUBLIC_LANGUAGE_SWITCHER_ENABLED=false
# Staff email notifications (Phase 15) — from Resend dashboard. Sending address must use a
# domain already verified on Resend, or delivery will fail/land in spam.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# GA4 measurement ID from GA4 Admin > Data Streams. Leave empty until the property exists.
NEXT_PUBLIC_GA_ID=

# Optional — bank transfer VietQR on the order confirmation page (Phase 5). Leave unset to hide
# the QR code and show plain COD/bank-transfer instructions instead.
# NEXT_PUBLIC_BANK_ID=
# NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
# NEXT_PUBLIC_BANK_ACCOUNT_NAME=

# Tests NEVER use app credentials. Optional for integration tests; required for E2E.
# Use a separate, disposable local Supabase instance. Hosted targets are refused.
TEST_DATABASE_URL=
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=

# Phase B (ADR-0033): storefront auto estimate via the MakerWorld resolver. Keep unset/false until
# Production logs show MakerWorld is reachable from Vercel; verified prices work without it.
MAKERWORLD_PUBLIC_RESOLVER_ENABLED=

# ADR-0039: customer screenshot → vision model → estimate. Off unless "true" AND GEMINI_API_KEY is set.
# Screenshots are sent to Google's Gemini API — mention it in the privacy policy before enabling.
MAKERWORLD_SCREENSHOT_ESTIMATE_ENABLED=
GEMINI_API_KEY=
# Optional, defaults to gemini-3.5-flash-lite (use gemini-3.8-flash if reads are often wrong)
MAKERWORLD_VISION_MODEL=

# Phase 33 S2: daily Vercel Cron /api/cron/cleanup-orphan-uploads deletes uploads that were never
# attached to a request. Vercel sends "Authorization: Bearer $CRON_SECRET" automatically once this is
# set in the project's env vars. Use ≥ 16 random characters (e.g. `openssl rand -hex 32`); without it
# the route always answers 401 and nothing is cleaned.
CRON_SECRET=

# Phase 33: /bao-gia + POST /api/public/quote-estimate. Keep false until the FDM estimate model is
# calibrated (scripts/fdm-model-calibration, S0 PASS → fdm-v1). When false both return 404.
NEXT_PUBLIC_BAO_GIA_ENABLED=false

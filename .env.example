# Database / Supabase
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ORDER_CONFIRMATION_SECRET=replace-with-at-least-32-random-characters

# Public origin. Change to the real HTTPS domain after the OWNER buys and connects it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Staff email notifications (Phase 15) — from Resend dashboard. Sending address must use a
# domain already verified on Resend, or delivery will fail/land in spam.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# GA4 measurement ID from GA4 Admin > Data Streams. Leave empty until the property exists.
NEXT_PUBLIC_GA_ID=

# Optional — bank transfer VietQR on the order confirmation page (Phase 5). Leave unset to hide
# the QR code and show plain COD/bank-transfer instructions instead.
# NEXT_PUBLIC_BANK_ID=
# NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
# NEXT_PUBLIC_BANK_ACCOUNT_NAME=

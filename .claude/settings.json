            "command": "bash -c 'exec bash \"/Users/sangpls/.local/pipx/venvs/vnx-orchestration/lib/python3.14/site-packages/vnx_orchestration/scripts/hooks/pretooluse_block_raw_claude_spawn.sh\"'",
